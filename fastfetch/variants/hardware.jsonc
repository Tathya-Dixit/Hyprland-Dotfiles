{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    { "type": "cpu", "showPeCoreCount": true, "temp": true },
    { "type": "gpu", "temp": true },
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "break",
    "colors"
  ]
}
